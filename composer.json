{
    "name": "pelican-provisioner/pelican-provisioner",
    "description": "Self-service server provisioning for Pelican Panel, with per-user CPU, memory, disk, and server quotas.",
    "type": "library",
    "authors": [
        {
            "name": "HttpRafa",
            "homepage": "https://github.com/HttpRafa"
        }
    ],
    "license": "GPL-3.0-only",
    "require": {
        "php": "^8.4 || ^8.5",
        "ext-ctype": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "larastan/larastan": "^3.14",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3",
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "PelicanProvisioner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "build": "@php scripts/build-zip.php",
        "check": [
            "@php vendor/bin/pint --test",
            "@analyse",
            "@test"
        ],
        "format": "@php vendor/bin/pint",
        "test": "@php vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
