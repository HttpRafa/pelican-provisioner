# Dev tools installed by Composer. The panel loads this plugin from src/ and does not use this directory.
/vendor

# Regenerated by composer check. Do not commit them.
/.phpunit.cache
.phpunit.result.cache
.phpstan.cache

# Import archives built for the panel. The recipe is in the README.
/dist/

# Editor and operating-system files.
.idea/
.vscode/
.DS_Store

# composer.lock stays tracked so CI installs the same dev tools.

# The local Wings stack writes a node token, a machine id, and live server files here.
# Those are credentials and other people's server data.
/docker/wings/etc/*
!/docker/wings/etc/.gitkeep
/docker/wings/volumes/*
!/docker/wings/volumes/.gitkeep
/docker/wings/tmp/*
!/docker/wings/tmp/.gitkeep
